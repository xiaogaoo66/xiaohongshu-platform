# --- PostgreSQL (Railway) ---
# 复制 Railway Dashboard 中的 DATABASE_URL（包含用户名、密码、host、port、数据库名）
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# --- JWT ---
# 使用 `openssl rand -hex 32` 或 https://generate-secret.vercel.app/64 生成随机字符串
JWT_SECRET="replace-with-64-char-random-secret"
JWT_EXPIRES_IN="24h"

# --- 阿里云 OSS ---
# 将 AccessKeyId / AccessKeySecret 替换为新生成的密钥（不要使用已暴露的旧密钥）
OSS_ACCESS_KEY_ID="AKID_REPLACE_ME"
OSS_ACCESS_KEY_SECRET="AKSECRET_REPLACE_ME"
OSS_REGION="oss-cn-chengdu"
OSS_BUCKET="xhs-content"
# 自定义公网访问域名（OSS 静态网站或 CDN 域名），用于生成公开文件 URL
OSS_PUBLIC_BASE_URL="https://xhs-content.oss-cn-chengdu.aliyuncs.com"
# 可选：如需固定 endpoint，可设置为 https://oss-cn-chengdu.aliyuncs.com；否则保持为空自动推导
OSS_ENDPOINT=""

# --- App / CORS ---
PORT=3000
NODE_ENV="production"
# 允许访问后端 API 的前端域名，多个域名用逗号分隔
FRONTEND_URL="https://xhs-content.oss-cn-chengdu.aliyuncs.com"

# --- 上传限制 ---
MAX_FILE_SIZE=5242880
MAX_FILES=9


