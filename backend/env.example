# 数据库配置
DATABASE_URL="postgresql://username:password@localhost:5432/xiaohongshu_db?schema=public"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="24h"

# AWS S3 配置
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-s3-bucket-name"

# 应用配置
PORT=3000
NODE_ENV="development"

# 前端 URL（用于 CORS 配置）
# 生产环境：设置为你的前端域名（OSS 或 CDN 地址）
# 多个域名用逗号分隔，例如：https://frontend.example.com,http://bucket.oss-cn-xxx.aliyuncs.com
# 如果不设置，默认允许所有来源（仅开发环境使用）
FRONTEND_URL=""

# 文件上传限制
MAX_FILE_SIZE=5242880
MAX_FILES=9


