# 数据库配置
DATABASE_URL="postgresql://username:password@localhost:5432/xiaohongshu_db?schema=public"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="24h"

# OSS 上传配置
OSS_ACCESS_KEY_ID="你的阿里云AccessKeyId"
OSS_ACCESS_KEY_SECRET="你的阿里云AccessKeySecret"
OSS_REGION="oss-cn-chengdu"
OSS_BUCKET="your-oss-bucket-name"
# 可选：自定义公网访问域名（确保前后端一致，例如 https://cdn.example.com）
OSS_PUBLIC_BASE_URL=""
# 兼容：如仍在使用 AWS S3，可继续保留 AWS_* 变量，系统会自动兼容

# 应用配置
PORT=3000
NODE_ENV="development"

# 前端 URL（用于 CORS 配置）
# 生产环境：设置为你的前端域名（OSS 或 CDN 地址）
# 多个域名用逗号分隔，例如：https://frontend.example.com,http://bucket.oss-cn-xxx.aliyuncs.com
# 如果不设置，默认允许所有来源（仅开发环境使用）
FRONTEND_URL=""

# 文件上传限制
MAX_FILE_SIZE=5242880
MAX_FILES=9


